{
  "name": "@ddgll/ts-crdt-client",
  "version": "0.1.3",
  "description": "Client library for ts-crdt, providing WebSocket synchronization.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc -w",
    "test": "vitest --run",
    "lint": "eslint . --ignore-pattern coverage --ignore-pattern dist",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@ddgll/ts-crdt": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^24.6.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
